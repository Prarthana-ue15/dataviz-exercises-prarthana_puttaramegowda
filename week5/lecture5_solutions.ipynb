import pandas as pd
import plotly.express as px
import numpy as np

# Load Airbnb London dataset from Kaggle
df = pd.read_csv(
    '/kaggle/input/datasets/prarthanap374/airbnb/airbnb_london.csv'
)

print(f"Loaded: {len(df)} listings")
print(df.head())
print(df.columns.tolist())


# Calculate the 95th percentile price
p95 = df['price'].quantile(0.95)

# Remove listings above the 95th percentile
df_cap = df[df['price'] <= p95].copy()

print(f"95th percentile price: £{p95:.0f}")

print(
    df_cap.groupby('room_type')['price']
    .describe()
    .round(1)
)


p95 = df['price'].quantile(0.95)
df_cap = df[df['price'] <= p95].copy()

print(f"95th percentile price: £{p95:.0f}")



# Task 1 — Histogram: Price by Room Type

# Select only Entire home/apt and Private room
room_df = df_cap[
    df_cap['room_type'].isin(['Entire home/apt', 'Private room'])
].copy()

# Calculate median price for each room type
medians = room_df.groupby('room_type')['price'].median()

# Create overlapping histogram
fig = px.histogram(
    room_df,
    x='price',
    color='room_type',
    barmode='overlay',
    opacity=0.6,
    nbins=50,
    color_discrete_map={
        'Entire home/apt': '#636EFA',
        'Private room': '#EF553B'
    },
    title='Entire Homes Have Higher Prices Than Private Rooms',
    labels={
        'price': 'Price per Night (£)',
        'room_type': 'Room Type'
    }
)

# Add median line for Entire home/apt
fig.add_vline(
    x=medians['Entire home/apt'],
    line_dash='dash',
    line_color='#636EFA',
    annotation_text=f"Entire home median: £{medians['Entire home/apt']:.0f}",
    annotation_position='top left'
)

# Add median line for Private room
fig.add_vline(
    x=medians['Private room'],
    line_dash='dash',
    line_color='#EF553B',
    annotation_text=f"Private room median: £{medians['Private room']:.0f}",
    annotation_position='top right'
)

# Annotate 95th percentile price cap
fig.add_annotation(
    x=0.5,
    y=-0.18,
    xref='paper',
    yref='paper',
    text=f"Prices above the 95th percentile (£{p95:.0f}) excluded",
    showarrow=False
)

# Improve layout
fig.update_layout(
    template='plotly_white',
    xaxis_title='Price per Night (£)',
    yaxis_title='Number of Listings',
    legend_title='Room Type'
)

fig.show()




# Task 2 — Box Plot: Listing Activity by Borough

# Detect the borough column
if 'borough' in df.columns:
    borough_col = 'borough'
elif 'neighbourhood' in df.columns:
    borough_col = 'neighbourhood'
elif 'neighbourhood_cleansed' in df.columns:
    borough_col = 'neighbourhood_cleansed'
else:
    raise KeyError(
        "Borough column not found. Check df.columns."
    )

# Remove listings with zero or missing reviews per month
activity_df = df[
    df['reviews_per_month'].notna()
    & (df['reviews_per_month'] > 0)
].copy()

# Calculate median reviews per month for each borough
borough_medians = (
    activity_df.groupby(borough_col)['reviews_per_month']
    .median()
    .sort_values(ascending=False)
)

# Identify the two most active boroughs
top_two = borough_medians.head(2).index.tolist()

print("Two most active boroughs:")
print(top_two)

# Sort boroughs by median activity
borough_order = borough_medians.index.tolist()

# Highlight the top two boroughs
activity_df['activity_group'] = activity_df[borough_col].apply(
    lambda x: 'Top 2 Most Active'
    if x in top_two
    else 'Other Boroughs'
)

# Create horizontal box plot
fig = px.box(
    activity_df,
    x='reviews_per_month',
    y=borough_col,
    color='activity_group',
    category_orders={
        borough_col: borough_order,
        'activity_group': [
            'Top 2 Most Active',
            'Other Boroughs'
        ]
    },
    points='outliers',
    color_discrete_map={
        'Top 2 Most Active': '#EF553B',
        'Other Boroughs': '#B0B0B0'
    },
    title=(
        f"{top_two[0]} and {top_two[1]} "
        "Have the Highest Median Listing Activity"
    ),
    labels={
        'reviews_per_month': 'Reviews per Month',
        borough_col: 'London Borough',
        'activity_group': 'Activity Group'
    }
)

# Add overall median reference line
overall_median = activity_df['reviews_per_month'].median()

fig.add_vline(
    x=overall_median,
    line_dash='dash',
    line_color='black',
    annotation_text=f'Overall median: {overall_median:.2f}',
    annotation_position='top'
)

# Improve layout
fig.update_layout(
    template='plotly_white',
    xaxis_title='Reviews per Month',
    yaxis_title='London Borough',
    legend_title='Activity Group',
    height=900
)

fig.show()

